---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title}</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Inter, Arial, sans-serif;
        background: #0b1120;
        color: white;
      }

      .container {
        width: 90%;
        max-width: 900px;
        margin: auto;
      }

      .article {
        padding: 80px 0;
      }

      .tag {
        display: inline-block;
        background: rgba(96, 165, 250, 0.12);
        color: #93c5fd;
        padding: 8px 16px;
        border-radius: 999px;
        margin-bottom: 25px;
      }

      h1 {
        font-size: 64px;
        margin-bottom: 30px;
        line-height: 1.2;
      }

      /* Markdown Content CSS */
      .content :global(p:first-of-type) {
        color: #94a3b8;
        line-height: 1.9;
        font-size: 20px;
        margin-bottom: 50px;
      }

      .content :global(h2) {
        margin-top: 56px;
        margin-bottom: 18px;
        font-size: 34px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .content :global(h3) {
        margin-top: 36px;
        margin-bottom: 12px;
        font-size: 22px;
        font-weight: 600;
        color: #e2e8f0;
      }

      .content :global(h4) {
        margin-top: 24px;
        margin-bottom: 10px;
        font-size: 15px;
        font-weight: 600;
        color: #93c5fd;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .content :global(p) {
        color: #cbd5e1;
        line-height: 1.9;
        margin-bottom: 20px;
        font-size: 18px;
      }

      .content :global(pre) {
        background: #111827 !important;
        padding: 25px;
        border-radius: 20px;
        overflow-x: auto;
        margin: 30px 0;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .content :global(code) {
        color: #93c5fd;
        font-size: 16px;
      }

      /* Output & Interview Tip Custom Blocks */
      .content :global(.output-box) {
        background: rgba(255, 255, 255, 0.05);
        padding: 20px 25px;
        border-radius: 12px;
        border-left: 4px solid #4ade80;
        margin-bottom: 30px;
      }

      .content :global(.output-box p) {
        margin: 0;
        color: #4ade80;
        font-family: monospace;
      }

      .content :global(.tip-box) {
        background: rgba(96, 165, 250, 0.05);
        padding: 30px;
        border-radius: 20px;
        border: 1px dashed rgba(96, 165, 250, 0.5);
        margin-top: 50px;
      }

      .content :global(.tip-box h2) {
        margin-top: 0;
        color: #60a5fa;
        font-size: 30px;
      }

      .content :global(.tip-box p) {
        margin-bottom: 0;
      }

      /* ── Table Styles ── */
      .content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 32px 0;
        font-size: 15px;
        table-layout: auto;
      }

      @media (max-width: 700px) {
        .content :global(table) {
          display: block;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
      }

      .content :global(thead tr) {
        background: rgba(96, 165, 250, 0.1);
      }

      .content :global(th) {
        padding: 12px 18px;
        text-align: left;
        font-weight: 600;
        color: #93c5fd;
        font-size: 13px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 2px solid rgba(96, 165, 250, 0.4);
      }

      .content :global(td) {
        padding: 11px 18px;
        color: #cbd5e1;
        border: 1px solid rgba(255, 255, 255, 0.07);
        vertical-align: top;
        line-height: 1.65;
      }

      .content :global(tbody tr:nth-child(even) td) {
        background: rgba(255, 255, 255, 0.03);
      }

      .content :global(tbody tr:hover td) {
        background: rgba(96, 165, 250, 0.05);
      }

      .content :global(table code) {
        background: rgba(96, 165, 250, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 13px;
      }
    </style>
    <GoogleAnalytics />
  </head>

  <body>
    <Header />

    <section class="article">
      <div class="container">
        <div class="tag">{frontmatter.tag}</div>
        <h1>{frontmatter.title}</h1>

        <div class="content">
          <slot />
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
