---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Krish Tech">
  <section class="about-section">
    <h1>About Us</h1>

    <p>
      We are learning modern web development using Astro and building
      blazing fast websites with clean UI and best performance.
    </p>
  </section>
</BaseLayout>

<style>
  .about-section {
    max-width: 900px;
    margin: auto;
    padding: 100px 20px;
    text-align: center;
  }

  .about-section h1 {
    font-size: 64px;
    margin-bottom: 30px;
  }

  .about-section p {
    font-size: 22px;
    line-height: 1.8;
    color: #cbd5e1;
  }
</style>
